{
  "name": "remote-arc-admin",
  "main": "src/worker/index.ts",
  "account_id": "6b1d0dd4e6f7f30df92753cd1e2ee12d",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "routes": [],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "PLATFORM_ADMIN",
      "service": "remote-link-relay",
      "entrypoint": "AdminApiService"
    }
  ],
  "vars": {
    "ADMIN_ORIGIN": "https://admin.remotearc.app",
    "APP_ORIGIN": "https://mcp.remotearc.app",
    "ADMIN_MODE": "production"
  },
  "observability": {
    "enabled": true
  }
}
