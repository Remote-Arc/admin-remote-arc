{
  "name": "remote-arc-admin-preview",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "routes": [],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_MODE": "preview",
    "ADMIN_ORIGIN": "https://admin-preview.invalid",
    "APP_ORIGIN": "https://mcp.remotearc.app"
  }
}
